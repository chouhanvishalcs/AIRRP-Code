{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chouhanvishalcs/AIRRP-Code/schema/import-bundle.schema.json",
  "title": "AIRRP import bundle",
  "type": "object",
  "required": ["schema", "framework", "requirements", "master_controls", "mappings", "bundle_sha256", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "airrp-import-bundle/1"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string"},
    "framework": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "version", "title", "regulation_code", "source_sha256"],
      "properties": {"code": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
                     "title": {"type": "string"}, "regulation_code": {"type": "string", "minLength": 1},
                     "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "requirements": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "frequency", "legalText", "legalTitle", "description", "ownerFunction",
                   "obligationType", "regulationCode", "sourceReference", "control_id", "kind",
                   "parent_control_id", "content_hash"],
      "properties": {
        "code": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "frequency": {"type": "string"}, "legalText": {"type": "string", "minLength": 1},
        "legalTitle": {"type": "string"}, "description": {"type": "string"}, "ownerFunction": {"type": "string"},
        "obligationType": {"const": "SourceRequirement"}, "regulationCode": {"type": "string"},
        "sourceReference": {"type": "string"}, "control_id": {"type": "string"},
        "kind": {"enum": ["base", "enhancement"]}, "parent_control_id": {"type": ["string", "null"]},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "master_controls": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "objective", "description", "domain", "frequency", "control_type", "evidence",
                   "test_procedure", "approved_by", "approved_at"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "domain": {"type": "string", "minLength": 1}, "frequency": {"type": "string", "minLength": 1}, "control_type": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "test_procedure": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1}}}},
    "mappings": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_code", "requirement_control_id", "master_control_id", "relationship", "is_primary",
                   "rationale", "reviewer", "reviewed_at"],
      "properties": {
        "requirement_code": {"type": "string"}, "requirement_control_id": {"type": "string"},
        "master_control_id": {"type": "string"},
        "relationship": {"enum": ["equivalent", "subset", "superset", "intersects"]},
        "is_primary": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string"}}}}
  }
}
