  "LLC": {"type": "Limited liability company (LLC)", "countries": ["US"]},
  "LLP": {"type": "Limited liability partnership (LLP)", "countries": ["GB", "US", "IN"]},
  "LP": {"type": "Limited partnership (LP)", "countries": ["US", "GB", "CA"]},
  "JSC": {"type": "Joint-stock company", "countries": ["RU", "KZ", "UA", "VN"]},
  "RU-OOO": {"type": "Obshchestvo s ogranichennoy otvetstvennostyu (OOO, limited liability company)", "countries": ["RU"]},
