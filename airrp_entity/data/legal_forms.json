"suffixes": [
  {"pattern": "株式会社|\\(株\\)|（株）|㈱", "form": "JP-KK", "anywhere": true},
  {"pattern": "合同会社", "form": "JP-GK", "anywhere": true},
  {"pattern": "有限会社", "form": "JP-YK", "anywhere": true},
  {"pattern": "주식회사|\\(주\\)|㈜", "form": "KR-JUSIK", "anywhere": true},
  {"pattern": "股份有限公司", "form": "CN-JSC", "anywhere": true},
  {"pattern": "有限责任公司|有限公司", "form": "CN-LTD", "anywhere": true},
  {"pattern": "GmbH\\s*&\\s*Co\\.?\\s*KG(?:aA)?", "form": "DE-GMBH-CO-KG", "cs": true},
  {"pattern": "S\\.?\\s?A\\.?\\s+de\\s+C\\.?\\s?V\\.?", "form": "MX-SADECV"},
  {"pattern": "Private\\s+Limited|Pvt\\.?\\s*Ltd\\.?", "form": "PVT-LTD", "in": {"SG": "SG-PTE", "MY": "MY-SDN"}},
  {"pattern": "Pte\\.?\\s*Ltd\\.?", "form": "SG-PTE"},
  {"pattern": "Pty\\.?\\s*Ltd\\.?|Proprietary\\s+Limited", "form": "AU-PTY"},
  {"pattern": "Sdn\\.?\\s*Bhd\\.?|Sendirian\\s+Berhad", "form": "MY-SDN"},
  {"pattern": "Bhd\\.?|Berhad", "form": "MY-BHD"},
  {"pattern": "Co\\.?\\s*,?\\s*Ltd\\.?|Company\\s+Limited", "form": "CO-LTD", "in": {"JP": "JP-KK", "KR": "KR-JUSIK", "GB": "LTD", "IE": "LTD", "HK": "LTD", "IN": "IN-LTD"}},
  {"pattern": "p\\.?\\s?l\\.?\\s?c\\.?|public\\s+limited\\s+company", "form": "PLC", "in": {"IN": "IN-LTD"}},
  {"pattern": "Limited|Ltd\\.?", "form": "LTD", "in": {"IN": "IN-LTD", "JP": "JP-KK"}},
  {"pattern": "L\\.?\\s?L\\.?\\s?P\\.?", "form": "LLP"},
  {"pattern": "L\\.?\\s?L\\.?\\s?C\\.?|Limited\\s+Liability\\s+Company", "form": "LLC", "in": {"JP": "JP-GK"}},
  {"pattern": "L\\.P\\.|LP|Limited\\s+Partnership", "form": "LP", "cs": true},
  {"pattern": "Incorporated|Inc\\.?", "form": "CORP", "in": {"JP": "JP-KK", "KR": "KR-JUSIK"}},
  {"pattern": "Corporation|Corp\\.?", "form": "CORP", "in": {"JP": "JP-KK", "KR": "KR-JUSIK"}},
  {"pattern": "K\\.\\s?K\\.|Kabushiki\\s+Kaisha", "form": "JP-KK"},
  {"pattern": "G\\.\\s?K\\.|Godo\\s+Kaisha", "form": "JP-GK"},
  {"pattern": "JSC|PJSC|CJSC|OJSC|Joint[- ]Stock\\s+Company|PAO|ПАО|АО", "form": "JSC", "cs": true},
  {"pattern": "OOO|ООО", "form": "RU-OOO", "cs": true},
  {"pattern": "GmbH", "form": "DE-GMBH", "cs": true},
  {"pattern": "KGaA", "form": "DE-KGAA", "cs": true},
  {"pattern": "AG", "form": "DE-AG", "cs": true},
  {"pattern": "KG", "form": "DE-KG", "cs": true},
  {"pattern": "OHG", "form": "DE-OHG", "cs": true},
  {"pattern": "e\\.\\s?V\\.", "form": "DE-EV", "cs": true},
  {"pattern": "SE", "form": "SE", "cs": true},
  {"pattern": "S\\.A\\.S\\.U?\\.?|SASU?", "form": "FR-SAS", "cs": true},
  {"pattern": "S\\.?A\\.?R\\.?L\\.?|S\\.à\\s?r\\.l\\.", "form": "FR-SARL", "cs": true},
  {"pattern": "S\\.p\\.A\\.?|SpA", "form": "IT-SPA", "cs": true},
  {"pattern": "S\\.r\\.l\\.?|Srl|S\\.R\\.L\\.", "form": "IT-SRL", "cs": true},
  {"pattern": "S\\.L\\.U?\\.?", "form": "ES-SL", "cs": true},
  {"pattern": "S\\.A\\.|SA", "form": "SA", "cs": true},
  {"pattern": "B\\.V\\.?|BV", "form": "NL-BV", "cs": true},
  {"pattern": "N\\.V\\.?|NV", "form": "NL-NV", "cs": true},
  {"pattern": "AB(?:\\s*\\(publ\\))?", "form": "SE-AB", "cs": true},
  {"pattern": "ASA", "form": "NO-ASA", "cs": true},
  {"pattern": "A/S", "form": "DK-AS", "cs": true, "in": {"NO": "NO-AS"}},
  {"pattern": "AS", "form": "NO-AS", "cs": true},
  {"pattern": "ApS", "form": "DK-APS", "cs": true},
  {"pattern": "Oyj", "form": "FI-OYJ", "cs": true},
  {"pattern": "Oy", "form": "FI-OY", "cs": true},
  {"pattern": "sp\\.\\s?z\\s?o\\.\\s?o\\.", "form": "PL-SPZOO"},
  {"pattern": "Ltda\\.?", "form": "BR-LTDA"},
  {"pattern": "Lda\\.?", "form": "PT-LDA", "cs": true},
  {"pattern": "A\\.Ş\\.", "form": "TR-AS", "cs": true},
  {"pattern": "Co-?operative|Cooperative|eG", "form": "COOP", "cs": true},
  {"pattern": "Foundation|Stiftung|Fondation|Fundación|Fondazione", "form": "FOUNDATION"}
]
}
