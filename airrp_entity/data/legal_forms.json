  "DE-KGAA": {"type": "Kommanditgesellschaft auf Aktien (KGaA, partnership limited by shares)", "countries": ["DE"]},
  "DE-KG": {"type": "Kommanditgesellschaft (KG, limited partnership)", "countries": ["DE", "AT"]},
  "DE-OHG": {"type": "Offene Handelsgesellschaft (OHG, general partnership)", "countries": ["DE"]},
  "DE-EV": {"type": "Eingetragener Verein (e.V., registered association)", "countries": ["DE"]},
  "SE": {"type": "Societas Europaea (SE, European public limited company)", "countries": []},
  "SA": {"type": "Société anonyme / sociedad anónima (public limited company)", "countries": ["FR", "BE", "LU", "CH", "ES", "PT", "PL", "AR", "CL", "PE", "CO"]},
  "MX-SADECV": {"type": "Sociedad anónima de capital variable (S.A. de C.V.)", "countries": ["MX"]},
  "FR-SAS": {"type": "Société par actions simplifiée (SAS)", "countries": ["FR"]},
  "FR-SARL": {"type": "Société à responsabilité limitée (SARL)", "countries": ["FR", "LU"]},
  "IT-SPA": {"type": "Società per azioni (S.p.A.)", "countries": ["IT"]},
  "IT-SRL": {"type": "Società a responsabilità limitata (S.r.l.)", "countries": ["IT"]},
  "ES-SL": {"type": "Sociedad limitada (S.L.)", "countries": ["ES"]},
  "NL-BV": {"type": "Besloten vennootschap (B.V., private limited company)", "countries": ["NL", "BE"]},
  "NL-NV": {"type": "Naamloze vennootschap (N.V., public limited company)", "countries": ["NL", "BE"]},
  "SE-AB": {"type": "Aktiebolag (AB, limited company)", "countries": ["SE", "FI"]},
  "NO-AS": {"type": "Aksjeselskap (AS, private limited company)", "countries": ["NO"]},
